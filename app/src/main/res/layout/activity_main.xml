<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorBackground"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="0dp">

        <TextView
            android:id="@+id/mainHeadline"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="@color/colorBackgroundLogo"
            android:text="@string/mainHeadline"
            android:textAlignment="center"
            android:textColor="@color/colorMain"
            android:textSize="26sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/krakowSausageButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/mainHeadline"
            android:layout_marginHorizontal="20sp"
            android:layout_marginTop="20sp"
            android:backgroundTint="@color/colorMain"
            android:text="@string/krakowSausage"
            android:textSize="19sp" />
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>