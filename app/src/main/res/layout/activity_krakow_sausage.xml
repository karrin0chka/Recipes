<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".KrakowSausage">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorBackground"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="0dp">

        <TextView
            android:id="@+id/krakowSausage"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="@color/colorBackgroundLogo"
            android:text="@string/krakowSausage"
            android:textAlignment="center"
            android:textColor="@color/colorMain"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/massHeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/krakowSausage"
            android:layout_marginHorizontal="20sp"
            android:layout_marginTop="5sp"
            android:text="@string/massHeadline"
            android:textSize="20sp" />

        <EditText
            android:id="@+id/massInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/massHeadline"
            android:layout_marginHorizontal="20sp"
            android:layout_marginTop="5sp"
            android:backgroundTint="@color/colorMain"
            android:ems="10"
            android:hint="@string/massInput"
            android:inputType="text"
            android:textSize="20sp" />

        <Button
            android:id="@+id/clearButton"
            android:layout_width="155sp"
            android:layout_height="wrap_content"
            android:layout_below="@+id/massInput"
            android:layout_alignParentStart="true"
            android:layout_marginStart="20sp"
            android:layout_marginTop="20sp"
            android:backgroundTint="@color/colorAdditionalButton"
            android:text="@string/clearButton"
            android:textSize="19sp" />

        <Button
            android:id="@+id/calculatorButton"
            android:layout_width="155sp"
            android:layout_height="wrap_content"
            android:layout_below="@+id/massInput"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20sp"
            android:backgroundTint="@color/colorMain"
            android:text="@string/calculatorButton"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/ingredientsHeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/clearButton"
            android:layout_marginStart="20sp"
            android:layout_marginTop="20sp"
            android:text="@string/ingredientsHeadline"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/proportionsHeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/clearButton"
            android:layout_marginStart="200sp"
            android:layout_marginTop="20sp"
            android:text="@string/proportionsHeadline"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/resultHeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/clearButton"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="30sp"
            android:text="@string/resultHeadline"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/saltHeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/ingredientsHeadline"
            android:layout_marginStart="20sp"
            android:layout_marginTop="20sp"
            android:text="@string/saltHeadline"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/saltProportions"
            android:layout_width="60sp"
            android:layout_height="36sp"
            android:layout_below="@+id/ingredientsHeadline"
            android:layout_marginStart="200sp"
            android:layout_marginTop="10sp"
            android:textSize="15sp"
            android:hint="@string/saltValue"
            />

        <TextView
            android:id="@+id/saltResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/ingredientsHeadline"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="50sp"
            android:hint="@string/nullValue"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/dextroseHeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/saltHeadline"
            android:layout_marginStart="20sp"
            android:layout_marginTop="15sp"
            android:text="@string/dextroseHeadline"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/dextroseProportions"
            android:layout_width="60sp"
            android:layout_height="36sp"
            android:layout_below="@+id/saltHeadline"
            android:layout_marginStart="200sp"
            android:layout_marginTop="5sp"
            android:textSize="15sp"
            android:hint="@string/dextroseValue" />

        <TextView
            android:id="@+id/dextroseResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/saltHeadline"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="50sp"
            android:hint="@string/nullValue"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/mNutHeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/dextroseHeadline"
            android:layout_marginStart="20sp"
            android:layout_marginTop="15sp"
            android:text="@string/mNutHeadline"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/mNutProportions"
            android:layout_width="60sp"
            android:layout_height="36sp"
            android:layout_below="@+id/dextroseHeadline"
            android:layout_marginStart="200sp"
            android:layout_marginTop="5sp"
            android:textSize="15sp"
            android:hint="@string/mNutValue" />

        <TextView
            android:id="@+id/mNutResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/dextroseHeadline"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="50sp"
            android:hint="@string/nullValue"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/fragrantPepperHeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/mNutHeadline"
            android:layout_marginStart="20sp"
            android:layout_marginTop="15sp"
            android:text="@string/fragrantPepperHeadline"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/fragrantPepperProportions"
            android:layout_width="60sp"
            android:layout_height="36sp"
            android:layout_below="@+id/mNutHeadline"
            android:layout_marginStart="200sp"
            android:layout_marginTop="5sp"
            android:textSize="15sp"
            android:hint="@string/fragrantPepperValue" />

        <TextView
            android:id="@+id/fragrantPepperResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/mNutHeadline"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="50sp"
            android:hint="@string/nullValue"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/blackPepperHeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/fragrantPepperHeadline"
            android:layout_marginStart="20sp"
            android:layout_marginTop="15sp"
            android:text="@string/blackPepperHeadline"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/blackPepperProportions"
            android:layout_width="60sp"
            android:layout_height="36sp"
            android:layout_below="@+id/fragrantPepperHeadline"
            android:layout_marginStart="200sp"
            android:layout_marginTop="5sp"
            android:textSize="15sp"
            android:hint="@string/blackPepperValue" />

        <TextView
            android:id="@+id/blackPepperResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/fragrantPepperHeadline"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="50sp"
            android:hint="@string/nullValue"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/whitePepperHeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/blackPepperHeadline"
            android:layout_marginStart="20sp"
            android:layout_marginTop="15sp"
            android:text="@string/whitePepperHeadline"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/whitePepperProportions"
            android:layout_width="60sp"
            android:layout_height="36sp"
            android:layout_below="@+id/blackPepperHeadline"
            android:layout_marginStart="200sp"
            android:layout_marginTop="5sp"
            android:textSize="15sp"
            android:hint="@string/whitePepperValue" />

        <TextView
            android:id="@+id/whitePepperResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/blackPepperHeadline"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="50sp"
            android:hint="@string/nullValue"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/garlicHeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/whitePepperHeadline"
            android:layout_marginStart="20sp"
            android:layout_marginTop="15sp"
            android:text="@string/garlicHeadline"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/garlicProportions"
            android:layout_width="60sp"
            android:layout_height="36sp"
            android:layout_below="@+id/whitePepperHeadline"
            android:layout_marginStart="200sp"
            android:layout_marginTop="5sp"
            android:textSize="15sp"
            android:hint="@string/garlicValue" />

        <TextView
            android:id="@+id/garlicResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/whitePepperHeadline"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="50sp"
            android:hint="@string/nullValue"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/ascorbateHeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/garlicHeadline"
            android:layout_marginStart="20sp"
            android:layout_marginTop="15sp"
            android:text="@string/ascorbateHeadline"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/ascorbateProportions"
            android:layout_width="60sp"
            android:layout_height="36sp"
            android:layout_below="@+id/garlicHeadline"
            android:layout_marginStart="200sp"
            android:layout_marginTop="5sp"
            android:textSize="15sp"
            android:hint="@string/ascorbateValue" />

        <TextView
            android:id="@+id/ascorbateResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/garlicHeadline"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="50sp"
            android:hint="@string/nullValue"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/phosphateHeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/ascorbateHeadline"
            android:layout_marginStart="20sp"
            android:layout_marginTop="15sp"
            android:text="@string/phosphateHeadline"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/phosphateProportions"
            android:layout_width="60sp"
            android:layout_height="36sp"
            android:layout_below="@+id/ascorbateHeadline"
            android:layout_marginStart="200sp"
            android:layout_marginTop="5sp"
            android:textSize="15sp"
            android:hint="@string/phosphateValue" />

        <TextView
            android:id="@+id/phosphateResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/ascorbateHeadline"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="50sp"
            android:hint="@string/nullValue"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/waterHeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/phosphateHeadline"
            android:layout_marginStart="20sp"
            android:layout_marginTop="15sp"
            android:text="@string/waterHeadline"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/waterProportions"
            android:layout_width="60sp"
            android:layout_height="36sp"
            android:layout_below="@+id/phosphateHeadline"
            android:layout_marginStart="200sp"
            android:layout_marginTop="5sp"
            android:textSize="15sp"
            android:hint="@string/waterValue" />

        <TextView
            android:id="@+id/waterResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/phosphateHeadline"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="50sp"
            android:hint="@string/nullValue"
            android:textSize="15sp" />

        <Button
            android:id="@+id/returnMainButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="@color/colorAdditionalButton"
            android:text="@string/returnMainButton"
            android:textSize="19sp" />

    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>